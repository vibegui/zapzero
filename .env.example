# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional
# ZAP_DATA=/path/to/dir   # default: ~/Library/Application Support/zap (snapshots + state)
# ZAP_PORT=8810
# ZAP_REFRESH_MIN=15                          # 0 turns the background refresh off
# ZAP_TRIAGE_MODEL=typesafe/jev-1.14          # OpenRouter decisions API
# ZAP_DRAFT_MODEL=anthropic/claude-haiku-5.5

# Calendar events after a reply: zapzero runs your Claude Code headless with only this tool allowed.
# ZAP_CLAUDE=~/.local/bin/claude
# ZAP_CALENDAR_TOOL=mcp__claude_ai_Google_Calendar__create_event
# ZAP_AGENT_MODEL=
