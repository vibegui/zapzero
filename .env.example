# Everything runs on your Claude subscription through Claude Code (claude -p). Nothing to set.
# Optional: an OpenRouter key (https://openrouter.ai/keys) unlocks Jev for triage, fast and cheap.
OPENROUTER_API_KEY=

# Optional
# ZAP_DATA=/path/to/dir   # default: ~/Library/Application Support/zap (snapshots + state)
# ZAP_PORT=8810
# ZAP_REFRESH_MIN=15                          # 0 turns the background refresh off
# ZAP_TRIAGE_MODEL=typesafe/jev-1.14          # OpenRouter decisions API
# ZAP_LLM=claude                              # claude (default when Claude Code is installed) | ollama | openrouter
# ZAP_OLLAMA_MODEL=                           # local model; unset = the first one installed in Ollama
# ZAP_OLLAMA_URL=http://127.0.0.1:11434
# ZAP_CLAUDE_MODEL=haiku                      # Claude Code model for drafts, rewrites, triage without Jev
# ZAP_TRIAGE=llm                              # triage with the chat model even when there is an OpenRouter key
# ZAP_DRAFT_MODEL=anthropic/claude-haiku-5.5  # only with ZAP_LLM=openrouter

# Calendar events after a reply: zapzero runs your Claude Code headless with only this tool allowed.
# ZAP_CLAUDE=~/.local/bin/claude
# ZAP_CALENDAR_TOOL=mcp__claude_ai_Google_Calendar__create_event
# ZAP_CALENDAR_UPDATE_TOOL=mcp__claude_ai_Google_Calendar__update_event
# ZAP_AGENT_MODEL=
