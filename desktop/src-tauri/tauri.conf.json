{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapzero",
  "version": "0.1.0",
  "identifier": "dev.zapzero.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      { "label": "main", "title": "zapzero", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "externalBin": ["binaries/zapzero-server"],
    "resources": { "../../dist/": "dist/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
